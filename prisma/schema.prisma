generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Expense {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  unitValue  Decimal  @db.Decimal(10, 2)
  quantity   Int
  totalValue Decimal  @db.Decimal(10, 2)
  date       DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("expenses")
}

model Sale {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  unitValue        Decimal  @db.Decimal(10, 2)
  quantity         Int
  grossValue       Decimal  @default(0) @db.Decimal(10, 2)
  discountValue    Decimal  @default(0) @db.Decimal(10, 2)
  platformFeeValue Decimal  @default(0) @db.Decimal(10, 2)
  totalValue       Decimal  @db.Decimal(10, 2)
  platform         String   @default("PERSONAL") @db.VarChar(20)
  date             DateTime @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  stockMovements   SaleStockMovement[]

  @@map("sales")
}

model Product {
  id                 Int      @id @default(autoincrement())
  sku                String   @unique @db.VarChar(100)
  name               String   @db.VarChar(255)
  isKit              Boolean  @default(false)
  quantity           Int
  soldQuantity       Int      @default(0)
  manufacturingValue Decimal  @default(0) @db.Decimal(10, 2)
  saleValue          Decimal  @db.Decimal(10, 2)
  photoUrl           String   @db.VarChar(2048)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  kitComponents      ProductComponent[] @relation("KitComponents")
  usedInKits         ProductComponent[] @relation("ComponentProduct")
  saleStockMovements SaleStockMovement[]

  @@map("products")
}

model SaleStockMovement {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@map("sale_stock_movements")
}

model ProductComponent {
  id          Int     @id @default(autoincrement())
  kitId       Int
  componentId Int
  quantity    Int
  kit         Product @relation("KitComponents", fields: [kitId], references: [id], onDelete: Cascade)
  component   Product @relation("ComponentProduct", fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([kitId, componentId])
  @@map("product_components")
}
